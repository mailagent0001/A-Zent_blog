---
import HpLayout from '../../layouts/HpLayout.astro';
const title = "沖縄県全域の企業向け|A-Zent";
const description = "沖縄県内の企業のIT導入・業務自動化を支援します。";
const crumbs = [{"name": "ホーム", "path": "/"}, {"name": "対応エリア・業種", "path": "/area/"}, {"name": "沖縄県全域の企業向け", "path": "/area/okinawa/"}];
---
<HpLayout title={title} description={description} path="/area/okinawa/" crumbs={crumbs} noindex>
<div class="pg old on" id="p-area-okinawa"><div class="doc"><div class="crumb"><a href="/">ホーム</a> › <a href="/area/">対応エリア・業種</a> › 沖縄県全域の企業向け</div><h1>沖縄県全域の企業向けのIT導入・業務自動化</h1><p>沖縄県内の企業のIT導入・業務自動化を支援します。</p><h2 style="margin:28px 0 8px">対応内容</h2><ul class="ck"><li>IT導入・DX支援</li><li>業務自動化</li><li>導入後の運用サポート</li></ul><h2 style="margin:28px 0 8px">相談の進め方</h2><ul class="ck"><li>オンライン(Google Meet)で、県内どこからでも相談できます</li><li>離島・北部など、移動が難しい地域でも進められます</li></ul><p style="margin-top:32px"><a class="btn" href="/contact/">事前相談・ご意見を送る ▷</a></p><p style="margin-top:20px"><a href="/area/">対応エリア・業種一覧へ</a></p></div></div>
</HpLayout>
