---
import HpLayout from '../../layouts/HpLayout.astro';
const title = "全国オンライン対応|A-Zent";
const description = "全国の企業に、オンラインでIT導入・業務自動化を支援します。";
const crumbs = [{"name": "ホーム", "path": "/"}, {"name": "対応エリア・業種", "path": "/area/"}, {"name": "全国オンライン対応", "path": "/area/online/"}];
---
<HpLayout title={title} description={description} path="/area/online/" crumbs={crumbs} noindex>
<div class="pg old on" id="p-area-online"><div class="doc"><div class="crumb"><a href="/">ホーム</a> › <a href="/area/">対応エリア・業種</a> › 全国オンライン対応</div><h1>全国オンライン対応のIT導入・業務自動化</h1><p>全国の企業に、オンラインでIT導入・業務自動化を支援します。</p><h2 style="margin:28px 0 8px">対応内容</h2><ul class="ck"><li>IT導入・DX支援</li><li>業務自動化</li><li>導入後の運用サポート</li></ul><h2 style="margin:28px 0 8px">進め方</h2><ul class="ck"><li>打ち合わせ・設定・サポートはオンラインで完結できます</li><li>画面共有で、現場の操作を一緒に確認します</li></ul><p style="margin-top:32px"><a class="btn" href="/contact/">事前相談・ご意見を送る ▷</a></p><p style="margin-top:20px"><a href="/area/">対応エリア・業種一覧へ</a></p></div></div>
</HpLayout>
