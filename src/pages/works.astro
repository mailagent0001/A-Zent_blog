---
import HpLayout from '../layouts/HpLayout.astro';
const title = "導入事例|A-Zent";
const description = "A-Zentの導入事例のご案内です。開業後に順次掲載します。";
const crumbs = [{"name": "ホーム", "path": "/"}, {"name": "導入事例", "path": "/works/"}];
---
<HpLayout title={title} description={description} path="/works/" crumbs={crumbs}>
<div class="pg old on" id="p-works"><div class="doc"><div class="crumb"><a href="/">ホーム</a> › 導入事例</div><h1>導入事例</h1><p>導入事例は、開業後に順次掲載します。</p><div style="border:2px dashed #c9c4be;border-radius:12px;padding:32px;text-align:center;color:#66615C">導入事例は、開業後に順次掲載します(枠のみ)</div><p style="margin-top:32px"><a class="btn" href="/contact/">事前相談・ご意見を送る ▷</a></p></div></div>
</HpLayout>
