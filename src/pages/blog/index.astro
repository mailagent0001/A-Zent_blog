---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import HpLayout from '../../layouts/HpLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const crumbs = [{ name: 'ホーム', path: '/' }, { name: 'コラム', path: '/blog/' }];
---
<HpLayout title="コラム|A-Zent" description="制度・補助金・IT活用などに関する情報を掲載しています。" path="/blog/" crumbs={crumbs}>
<div class="pg old on"><div class="doc wide">
  <div class="crumb"><a href="/">ホーム</a> › コラム</div>
  <h1>コラム</h1>
  <p>制度・補助金・IT活用などに関する情報を掲載しています。</p>
  <ul class="list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          {post.data.heroImage && <Image width={720} height={360} src={post.data.heroImage} alt="" />}
          <h2>{post.data.title}</h2>
          <p class="date">{fmt(post.data.pubDate)}</p>
        </a>
      </li>
    ))}
  </ul>
</div></div>
</HpLayout>
<style>
  .wide { max-width: 1000px !important; }
  .list { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .list a { display: block; text-decoration: none; color: inherit; }
  .list img { width: 100%; height: auto; border-radius: 12px; display: block; margin-bottom: 10px; }
  .list h2 { font-size: 1.05rem; line-height: 1.5; margin: 0; padding: 0; border: 0; }
  .list a:hover h2 { color: var(--em); }
  .date { margin: 4px 0 0; font-size: .82rem; color: #66615C; }
  @media (max-width: 720px) { .list { grid-template-columns: 1fr; gap: 20px; } }
</style>
