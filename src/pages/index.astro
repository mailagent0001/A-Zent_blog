y1="5" x2="12" y2="12" transform="rotate(270 12 12)"/><line x1="12" y1="3" x2="12" y2="12" transform="rotate(300 12 12)"/><line x1="12" y1="6" x2="12" y2="12" transform="rotate(330 12 12)"/></g></svg></span><span class="lg"><svg viewBox="0 0 24 24" role="img" aria-label="Perplexity"><path fill="none" stroke="#20808D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 2v20M5 7.5l7 5 7-5M5 7.5v9l7 5.5 7-5.5v-9M5 7.5L12 2l7 5.5"/></svg></span><span class="lg"><svg viewBox="0 0 24 24" role="img" aria-label="Manus"><rect x="2" y="2" width="20" height="20" rx="5" fill="#1A1816"/><path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" d="M6.5 17V10a2.5 2.5 0 0 1 5 0V17M11.5 10a2.5 2.5 0 0 1 5 0V17"/></svg></span><span class="lg"><svg viewBox="0 0 24 24" role="img" aria-label="Canva"><defs><linearGradient id="cv" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#00C4CC"/><stop offset="1" stop-color="#7D2AE8"/></linearGradient></defs><circle cx="12" cy="12" r="10.5" fill="url(#cv)"/><path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" d="M16 9.3a5 5 0 1 0 0 5.4"/></svg></span><span class="lg"><svg viewBox="0 0 24 24" role="img" aria-label="Gamma"><defs><linearGradient id="gm" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6D5BFF"/><stop offset="1" stop-color="#FF7A59"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="6" fill="url(#gm)"/><path fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M7.5 7.5l4.5 5.5v4.5M16.5 7.5L12 13"/></svg></span><span class="lg"><svg viewBox="0 0 24 24" role="img" aria-label="Grok"><circle cx="12" cy="12" r="7.5" fill="none" stroke="#1A1816" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path fill="none" stroke="#1A1816" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 20L20 4"/></svg></span><span class="lg"><svg viewBox="0 0 24 24" role="img" aria-label="NotebookLM">