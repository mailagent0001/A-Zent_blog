---
import HpLayout from '../layouts/HpLayout.astro';
const title = "沖縄のIT導入・DX支援・業務自動化|A-Zent(アゼント)";
const description = "沖縄の企業向けに、IT導入・DX支援と業務自動化を、導入後のサポートまで伴走します。事前のご相談・ご意見を受付中。全国オンライン対応。";
const ld = [{"@context": "https://schema.org", "@type": "ProfessionalService", "name": "A-Zent(アゼント)", "url": "https://a-zent.com/", "email": "info@a-zent.com", "areaServed": ["沖縄県", "日本"], "description": "沖縄の企業向けに、IT導入・DX支援と業務自動化を、導入後のサポートまで伴走します。事前のご相談・ご意見を受付中。全国オンライン対応。"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ITに詳しくないのですが大丈夫ですか?", "acceptedAnswer": {"@type": "Answer", "text": "専門用語は使わず、現場の業務に沿った言葉でご説明します。"}}, {"@type": "Question", "name": "どのくらいの費用がかかりますか?", "acceptedAnswer": {"@type": "Answer", "text": "内容によって変わるため、ヒアリング後に正式なお見積りをご提示します。"}}, {"@type": "Question", "name": "沖縄県外でも対応できますか?", "acceptedAnswer": {"@type": "Answer", "text": "オンライン(Google Meet)でのご相談・対応が可能です。"}}, {"@type": "Question", "name": "まず相談だけしたいのですが大丈夫ですか?", "acceptedAnswer": {"@type": "Answer", "text": "もちろんです。現在は、事前のご相談・ご意見を受け付けています。"}}, {"@type": "Question", "name": "必ず成果が出ますか?", "acceptedAnswer": {"@type": "Answer", "text": "効果は、業務の内容や現場の状況によって異なるため、必ず成果が出るとお約束することはできません。効果が見込みにくい場合は、ご相談の段階で正直にお伝えします。"}}, {"@type": "Question", "name": "どのくらいの期間で変わりますか?", "acceptedAnswer": {"@type": "Answer", "text": "内容によって異なります。小さな自動化は短い期間で形になることもありますが、現場に定着するまでは、使いながら調整する期間が必要です。具体的な期間は、ご相談をうかがったうえでお伝えします。"}}, {"@type": "Question", "name": "導入後のサポートはありますか?", "acceptedAnswer": {"@type": "Answer", "text": "導入して終わりにせず、運用ルールづくりや、使い始めてからのご相談まで伴走する方針です。サポートの範囲は、ご相談の際にご説明します。"}}, {"@type": "Question", "name": "対応できない内容はありますか?", "acceptedAnswer": {"@type": "Answer", "text": "法令や公序良俗に反する内容、専門資格が必要な業務(税務相談、労務の手続代行など)はお受けできません。必要な場合は、専門家へのご相談をおすすめします。"}}, {"@type": "Question", "name": "今すぐ依頼できますか?", "acceptedAnswer": {"@type": "Answer", "text": "現在は、事前のご相談・ご意見を受け付けている段階で、契約や有償サービスの提供は行っておりません。事業化が決まった際に、ご相談いただいた企業様へ優先してご案内します。"}}, {"@type": "Question", "name": "一部の業務だけの相談でもよいですか?", "acceptedAnswer": {"@type": "Answer", "text": "はい。特定の業務だけの整理や、ツールの選び方だけといったご相談でも構いません。"}}]}];
---
<HpLayout title={title} description={description} path="/" ld={ld}>
