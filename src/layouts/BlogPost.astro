---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import HpLayout from './HpLayout.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const path = Astro.url.pathname;
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<HpLayout title={`${title}|A-Zent`} description={description} path={path} crumbs={[{ name: 'ホーム', path: '/' }, { name: 'コラム', path: '/blog/' }, { name: title, path }]} ogImage={heroImage?.src}>
<div class="pg old on"><article class="doc">
  <div class="crumb"><a href="/">ホーム</a> › <a href="/blog/">コラム</a> › {title}</div>
  <h1>{title}</h1>
  <p class="meta">{fmt(pubDate)}{updatedDate && <> (更新: {fmt(updatedDate)})</>}</p>
  {heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}
  <div class="prose"><slot /></div>
  <p style="margin-top:48px"><a class="btn" href="/contact/">事前相談・ご意見を送る ▷</a></p>
</article></div>
</HpLayout>
<style>
  .meta { font-size: .85rem; color: #7A7570; margin: 0 0 16px; }
  .hero { width: 100%; height: auto; border-radius: 12px; margin: 8px 0 24px; display: block; }
  .prose { line-height: 1.9; }
  .prose :global(h2) { font-size: 1.3rem; margin: 40px 0 12px; padding-left: 12px; border-left: 4px solid var(--em); }
  .prose :global(h3) { font-size: 1.1rem; margin: 28px 0 8px; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(a) { color: var(--em2); }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .prose :global(blockquote) { margin: 1em 0; padding: 8px 16px; border-left: 4px solid #ddd; color: #4a4642; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin: 1em 0; }
  .prose :global(th), .prose :global(td) { border: 1px solid #e5e1dc; padding: 8px 12px; }
  .prose :global(pre) { overflow-x: auto; padding: 12px; background: #FAFAF9; border-radius: 8px; }
</style>
